---
import '../styles/global.css';
import { u } from '../lib/u.mjs';
const { title, description } = Astro.props;
const desc =
  description ??
  "Jahon davlatlarining iqtisodiy va demografik ko'rsatkichlari — YaIM, inflyatsiya, ishsizlik, aholi va yana 80 dan ortiq ko'rsatkich o'zbek tilida. Manba: World Bank, IMF, UNDP.";
---
<!doctype html>
<html lang="uz">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="logo" aria-label="Mamlakatlar iqtisodi — bosh sahifa">
          <span class="mark">MI</span>
          <span>Mamlakatlar iqtisodi</span>
        </a>
        <nav class="main-nav" aria-label="Asosiy navigatsiya">
          <a href={u('/davlatlar')}>Davlatlar</a>
          <a href={u('/korsatkichlar')}>Ko'rsatkichlar</a>
          <a href={u('/taqqoslash')}>Taqqoslash</a>
          <a href={u('/lugat')}>Lug'at</a>
          <a href={u('/manbalar')}>Manbalar</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div class="col">
            <a href={u('/')}><b>Mamlakatlar iqtisodi</b></a>
            <small>Jahon davlatlarining iqtisodiy-demografik ko'rsatkichlari o'zbek tilida.</small>
          </div>
          <div class="col">
            <a href={u('/davlatlar')}>Davlatlar</a>
            <a href={u('/korsatkichlar')}>Ko'rsatkichlar</a>
            <a href={u('/taqqoslash')}>Taqqoslash</a>
          </div>
          <div class="col">
            <a href={u('/lugat')}>Lug'at</a>
            <a href={u('/manbalar')}>Manbalar</a>
            <a href={u('/haqida')}>Sayt haqida</a>
          </div>
        </div>
        <small>
          Ma'lumotlar ochiq manbalardan olingan: World Bank, IMF, UNDP (HDI). Ular rasmiy
          statistikadan farq qilishi mumkin. Sayt matnlari va dizayni mualliflik huquqi bilan himoyalangan.
        </small>
      </div>
    </footer>
  </body>
</html>
