---
import '../styles/global.css';
import { u } from '../lib/u.mjs';
const { title, description } = Astro.props;
const desc =
  description ??
  "Jahon davlatlarining iqtisodiy va demografik körsatkiçlari — YaIM, inflyatsiya, işsizlik, aholi va yana 80 dan ortiq körsatkiç özbek tilida. Manba: World Bank, IMF, UNDP.";
---
<!doctype html>
<html lang="uz">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="logo" aria-label="Mamlakatlar iqtisodi — boş sahifa">
          <span class="mark">MI</span>
          <span>Mamlakatlar iqtisodi</span>
        </a>
        <nav class="main-nav" aria-label="Asosiy navigatsiya">
          <a href={u('/davlatlar')}>Davlatlar</a>
          <a href={u('/korsatkichlar')}>Körsatkiçlar</a>
          <a href={u('/taqqoslash')}>Taqqoslaş</a>
          <a href={u('/lugat')}>Luğat</a>
          <a href={u('/manbalar')}>Manbalar</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">

      <div class="wrap">
        <div class="cols">
          <div class="col">
            <a href={u('/')}><b>Mamlakatlar iqtisodi</b></a>
            <small>Jahon davlatlarining iqtisodiy-demografik körsatkiçlari özbek tilida.</small>
          </div>
          <div class="col">
            <a href={u('/davlatlar')}>Davlatlar</a>
            <a href={u('/korsatkichlar')}>Körsatkiçlar</a>
            <a href={u('/taqqoslash')}>Taqqoslaş</a>
          </div>
          <div class="col">
            <a href={u('/lugat')}>Luğat</a>
            <a href={u('/manbalar')}>Manbalar</a>
            <a href={u('/haqida')}>Sayt haqida</a>
          </div>
        </div>
        <small>
          Ma'lumotlar oçiq manbalardan olingan: World Bank, IMF, UNDP (HDI). Ular rasmiy
          statistikadan farq qilişi mumkin. Sayt matnlari va dizayni mualliflik huquqi bilan himoyalangan.
        </small>
      </div>
    </footer>

    <script>
      /* ============================================================
         Jadval kuchaytirgich: saralaş + CSV/Excel eksport
         Barcha table.data jadvallarga avtomatik qo'llanadi.
         Dinamik jadvallar uchun: document.dispatchEvent(new Event('tables:render'))
         ============================================================ */
      (() => {
        'use strict';

        const rawVal = (td) => {
          const v = td?.getAttribute?.('data-v');
          if (v == null || v === '') return null;
          const n = parseFloat(v);
          return Number.isFinite(n) ? n : null;
        };

        const escCsv = (s) => {
          const str = String(s ?? '').trim();
          return /[";\n]/.test(str) ? '"' + str.replace(/"/g, '""') + '"' : str;
        };

        const escXml = (s) =>
          String(s ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');

        /* ---- eksport ma'lumotlarini yig'ish ---- */
        const cleanText = (td) => td.textContent.replace(/↗/g, '').trim();
        function exportData(table) {
          const ths = Array.from(table.tHead?.rows[0]?.cells ?? []);
          const header = ths.map((th) => th.textContent.replace(/[▲▼]/g, '').trim());
          const rows = [];
          for (const tr of table.tBodies[0].rows) {
            if (tr.style.display === 'none') continue;
            rows.push(
              Array.from(tr.cells).map((td) => {
                const raw = rawVal(td);
                return raw != null ? raw : cleanText(td);
              })
            );
          }
          return { header, rows };
        }

        function download(name, mime, content) {
          const blob = new Blob(['\uFEFF' + content], { type: mime + ';charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = name;
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 4000);
        }

        function toCsv(table) {
          const { header, rows } = exportData(table);
          const lines = [header.map(escCsv).join(';')];
          for (const r of rows) lines.push(r.map((c) => (typeof c === 'number' ? String(c) : escCsv(c))).join(';'));
          return lines.join('\r\n');
        }

        function toExcelXml(table) {
          const { header, rows } = exportData(table);
          const cell = (v) =>
            typeof v === 'number'
              ? '<Cell><Data ss:Type="Number">' + v + '</Data></Cell>'
              : '<Cell><Data ss:Type="String">' + escXml(v) + '</Data></Cell>';
          let xml = '<?xml version="1.0" encoding="UTF-8"?>';
          xml += '<?mso-application progid="Excel.Sheet"?>';
          xml += '<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">';
          xml += '<Styles><Style ss:ID="hdr"><Font ss:Bold="1"/></Style></Styles>';
          const sheet = (table.dataset.name || 'Malumotlar').replace(/[^A-Za-z0-9]/g, '').slice(0, 28) || 'Malumotlar';
          xml += '<Worksheet ss:Name="' + sheet + '"><Table>';
          xml += '<Row>' + header.map((h) => '<Cell ss:StyleID="hdr"><Data ss:Type="String">' + escXml(h) + '</Data></Cell>').join('') + '</Row>';
          for (const r of rows) xml += '<Row>' + r.map(cell).join('') + '</Row>';
          xml += '</Table></Worksheet></Workbook>';
          return xml;
        }

        /* ---- saralaş ---- */
        function enhanceTable(table) {
          if (table.dataset.enhanced || !table.tHead || !table.tBodies[0]) return;
          const tbody = table.tBodies[0];
          const original = Array.from(tbody.rows);
          if (original.length < 2) return;
          table.dataset.enhanced = '1';

          const ths = Array.from(table.tHead.rows[0].cells);
          const colIsNum = ths.map((_, i) => {
            let n = 0, total = 0;
            for (const tr of original) {
              const td = tr.cells[i];
              if (!td) continue;
              total++;
              if (rawVal(td) != null) n++;
            }
            return total > 0 && n / total >= 0.6;
          });

          const state = ths.map(() => 0); // 0 — asl, 1 — boshlang'ich, 2 — teskari

          const applySort = (col) => {
            const primaryDir = ths[col].dataset.first === 'desc' ? -1 : 1;
            const dir = state[col] === 1 ? primaryDir : -primaryDir;
            const num = colIsNum[col];
            const arr = original.slice().sort((a, b) => {
              const atd = a.cells[col], btd = b.cells[col];
              if (num) {
                const an = rawVal(atd), bn = rawVal(btd);
                const A = an == null ? (dir === 1 ? Infinity : -Infinity) : an;
                const B = bn == null ? (dir === 1 ? Infinity : -Infinity) : bn;
                if (A !== B) return (A - B) * dir;
                return 0;
              }
              const A = (atd?.textContent || '').replace(/↗/g, '').trim();
              const B = (btd?.textContent || '').replace(/↗/g, '').trim();
              return A.localeCompare(B, 'uz') * dir;
            });
            const frag = document.createDocumentFragment();
            for (const tr of arr) frag.appendChild(tr);
            tbody.appendChild(frag);
          };

          ths.forEach((th, i) => {
            th.classList.add('sortable');
            th.setAttribute('tabindex', '0');
            th.setAttribute('role', 'columnheader');
            const arrow = document.createElement('span');
            arrow.className = 'arrow';
            th.appendChild(arrow);

            const toggle = () => {
              for (let j = 0; j < ths.length; j++) {
                if (j !== i) { state[j] = 0; ths[j].querySelector('.arrow').textContent = ''; ths[j].removeAttribute('aria-sort'); }
              }
              state[i] = (state[i] + 1) % 3;
              if (state[i] === 0) {
                arrow.textContent = '';
                th.removeAttribute('aria-sort');
                const frag = document.createDocumentFragment();
                for (const tr of original) frag.appendChild(tr);
                tbody.appendChild(frag);
                return;
              }
              applySort(i);
              const primaryDir = th.dataset.first === 'desc' ? -1 : 1;
              arrow.textContent = (state[i] === 1) === (primaryDir === 1) ? '▲' : '▼';
              th.setAttribute('aria-sort', primaryDir === 1 ? (state[i] === 1 ? 'ascending' : 'descending') : (state[i] === 1 ? 'descending' : 'ascending'));
            };
            th.addEventListener('click', toggle);
            th.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
          });

          /* ---- eksport tugmalari ---- */
          const tools = document.createElement('div');
          tools.className = 'table-tools';
          const baseName = table.dataset.name || 'jadval';
          const mkBtn = (label, title, fn) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'btn-dl';
            b.title = title;
            b.innerHTML = label;
            b.addEventListener('click', fn);
            return b;
          };
          tools.appendChild(
            mkBtn(
              '⬇ CSV',
              'CSV formatında yuklab aliş (Excel ile oçiladi)',
              () => download(baseName + '.csv', 'text/csv', toCsv(table))
            )
          );
          tools.appendChild(
            mkBtn(
              '⬇ Excel',
              'Excel formatında yuklab aliş (.xls)',
              () => download(baseName + '.xls', 'application/vnd.ms-excel', toExcelXml(table))
            )
          );
          table.parentNode.insertBefore(tools, table);
        }

        const enhanceAll = (root) => {
          for (const t of (root || document).querySelectorAll('table.data')) enhanceTable(t);
        };
        window.__enhanceTables = enhanceAll;
        document.addEventListener('tables:render', () => enhanceAll(document.getElementById('compareOut') || document));
        enhanceAll(document);
      })();
    </script>

    <script>
      /* ============================================================
         Grafik qiymat oynasi — "eng yaqin nuqta" mantig'i:
         sichqoncha grafik ustida harakatlangan, o'qqa eng yaqin
         nuqtaning qiymati barqaror ko'rsatiladi (miltillashsiz).
         Barcha SVG grafiklarda (asosiy + ochiladigan panellar) ishlaydi.
         ============================================================ */
      (() => {
        'use strict';
        let tip = null;
        let cache = new WeakMap();
        let activeDot = null;

        const ensure = () => {
          if (!tip) {
            tip = document.createElement('div');
            tip.className = 'chart-tip';
            document.body.appendChild(tip);
          }
          return tip;
        };

        const hide = () => {
          if (tip) tip.style.display = 'none';
          if (activeDot) {
            activeDot.classList.remove('hovered');
            activeDot = null;
          }
        };

        const position = (e) => {
          const t = ensure();
          const w = t.offsetWidth || 120;
          const h = t.offsetHeight || 26;
          let x = e.clientX + 14;
          let y = e.clientY - h - 10;
          if (x + w > window.innerWidth - 8) x = e.clientX - w - 14;
          if (y < 8) y = e.clientY + 18;
          t.style.left = x + 'px';
          t.style.top = y + 'px';
        };

        /* svg ichidagi nuqtalarning ekran koordinatalari (keshlanadi) */
        const pointsOf = (svg) => {
          let arr = cache.get(svg);
          if (!arr) {
            arr = [];
            for (const c of svg.querySelectorAll('circle.hit[data-tip]')) {
              const r = c.getBoundingClientRect();
              if (r.width > 0) {
                arr.push({ x: r.x + r.width / 2, y: r.y + r.height / 2, hit: c });
              }
            }
            cache.set(svg, arr);
          }
          return arr;
        };

        const TH = 42 * 42; /* 42 px radius — nuqta "yaqinida" hisoblanadi */

        document.addEventListener('mousemove', (e) => {
          const el = e.target;
          if (!el || typeof el.closest !== 'function') return;
          const svg = el.closest('svg');
          if (!svg) {
            hide();
            return;
          }
          const pts = pointsOf(svg);
          if (!pts.length) {
            hide();
            return;
          }
          let best = null;
          let bestD = Infinity;
          for (const p of pts) {
            const dx = p.x - e.clientX;
            const dy = p.y - e.clientY;
            const d = dx * dx + dy * dy;
            if (d < bestD) {
              bestD = d;
              best = p;
            }
          }
          if (!best || bestD > TH) {
            hide();
            return;
          }
          const t = ensure();
          const txt = best.hit.getAttribute('data-tip');
          const sep = txt.indexOf(': ');
          if (sep > 0) {
            t.innerHTML = '<span class="chart-tip-year">' + txt.slice(0, sep) + '</span><br>' + txt.slice(sep + 2);
          } else {
            t.textContent = txt;
          }
          t.style.display = 'block';
          position(e);

          const dot = best.hit.nextElementSibling;
          if (activeDot !== dot) {
            if (activeDot) activeDot.classList.remove('hovered');
            activeDot = dot;
            if (activeDot) activeDot.classList.add('hovered');
          }
        });

        document.addEventListener('scroll', () => hide(), { capture: true, passive: true });
        window.addEventListener('resize', () => {
          cache = new WeakMap();
          hide();
        });
        window.addEventListener('blur', () => hide());
        document.addEventListener('mouseleave', () => hide());
      })();
    </script>
  </body>
</html>
