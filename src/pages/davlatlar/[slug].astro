---
import Base from '../../layouts/Base.astro';
import Flag from '../../components/Flag.astro';
import LineChart from '../../components/LineChart.astro';
import { u } from '../../lib/u.mjs';
import { registry, fmtValue, fmtNum, rankOf, seriesOf } from '../../lib/data.mjs';

export function getStaticPaths() {
  const R = registry();
  return R.countries.map((c) => ({ params: { slug: c.slug } }));
}

const slug = Astro.params.slug;
const R = registry();
const country = R.countries.find((c) => c.slug === slug);
if (!country) throw new Error(`Davlat topilmadi: ${slug}`);

const iso = country.iso3;
const S = (sl) => R.bySlug.get(sl);
const L = (sl) => S(sl)?.latest[iso];

const popy = S('aholi');
const gdp = S('yaim');
const gdpPc = S('yaim-jon-boshi');
const gdpG = S('yaim-osish');
const infl = S('inflyatsiya');
const dens = S('zichlik');
const fx = S('valyuta-kursi');
const life = S('umr-davomiyligi');
const hdi = S('itt');

const capital = R.capitals[iso] ?? country.capitalEn;

const popL = L('aholi');
const gdpL = L('yaim');
const gdpPcL = L('yaim-jon-boshi');
const inflL = L('inflyatsiya');
const debtL = L('davlat-qarzi');
const lifeL = L('umr-davomiyligi');
const hdiL = L('itt');

const popRank = rankOf(popy, iso);
const gdpRank = rankOf(gdp, iso);
const gdpPcRank = rankOf(gdpPc, iso);
const hdiRank = rankOf(hdi, iso);

function lastPoints(ind, n = 32) {
  const s = seriesOf(ind, iso);
  if (!s) return [];
  return s.slice(-n);
}

const charts = [
  { ind: gdp, key: 'yaim' },
  { ind: gdpG, key: 'yaim-osish' },
  { ind: infl, key: 'inflyatsiya' },
  { ind: popy, key: 'aholi' },
  { ind: life, key: 'umr-davomiyligi' },
  { ind: fx, key: 'valyuta-kursi' }
].filter((c) => c.ind && lastPoints(c.ind).length >= 4);

const catKeys = Object.keys(R.catalog.categories);
const groups = catKeys
  .map((key) => ({
    key,
    label: R.catalog.categories[key],
    inds: R.indicators.filter((i) => i.cat === key)
  }))
  .filter((g) => g.inds.length);

const idx = R.countries.findIndex((c) => c.slug === slug);
const prev = R.countries[idx - 1];
const next = R.countries[idx + 1];

/* Yillar kesimi — davlat sahifasidagi ochiladigan panellar uchun ixcham ma'lumot */
const hist = {};
for (const ind of R.indicators) {
  const s = ind.series[iso];
  if (s && s.length) {
    hist[ind.slug] = { n: ind.name, u: ind.unit, d: ind.dec, src: ind.source, s };
  }
}
const histJson = JSON.stringify(hist).replace(/</g, '\\u003c');

const title = `${country.nameUz} — iqtisodiy va demografik körsatkiçlar`;
const desc = `${country.nameUz}: YaIM ${gdpL ? fmtValue(gdp, gdpL.value) : '—'}, aholi ${popL ? fmtValue(popy, popL.value) : '—'}, inflyatsiya ${inflL ? fmtValue(infl, inflL.value) : '—'}. ${R.indicators.length} körsatkiçning yillar kesimi va reytinglari.`;
---

<Base title={`${title} | Mamlakatlar iqtisodi`} description={desc}>
  <div class="crumbs">
    <a href={u('/')}>Boş sahifa</a> › <a href={u('/davlatlar')}>Davlatlar</a> › {country.nameUz}
  </div>

  <div class="page-head" style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
    <Flag iso2={country.iso2} iso3={iso} big />
    <div style="flex:1; min-width:250px;">
      <h1>{country.nameUz}</h1>
      <p class="lead" style="margin:0;">
        <span class="badge">{country.regionUz}</span>
        {country.incomeUz && <span class="badge amber">{country.incomeUz}</span>}
        {country.isAggregate && <span class="badge">agregat</span>}
        <span style="display:block; margin-top:6px; font-size:13.5px;">
          Körsatkiç nomiga bosing — o'sha davlat üçün yillar kesimi jadvali va grafigi oçiladi.
        </span>
      </p>
    </div>
    <div style="display:flex; gap:8px;">
      <a class="btn primary" href={u(`/taqqoslash?a=${country.slug}`)}>Taqqoslaş</a>
    </div>
  </div>

  <div class="card">
    <div class="facts">
      <div class="fact">
        <div class="k">Poytaxt</div>
        <div class="v">{capital}</div>
      </div>
      <div class="fact">
        <div class="k">Aholi</div>
        <div class="v">{popL ? fmtValue(popy, popL.value) : '—'}</div>
        {popL && <small>{popL.year}-yil {popRank ? `· ${popRank.rank}-örin` : ''}</small>}
      </div>
      <div class="fact">
        <div class="k">Aholi ziçligi</div>
        <div class="v">{L('zichlik') ? fmtNum(L('zichlik').value, 1) : '—'}<small>kişi / km²</small></div>
      </div>
      <div class="fact">
        <div class="k">YaIM</div>
        <div class="v">{gdpL ? fmtValue(gdp, gdpL.value) : '—'}</div>
        {gdpL && <small>{gdpL.year}-yil {gdpRank ? `· ${gdpRank.rank}-örin` : ''}</small>}
      </div>
      <div class="fact">
        <div class="k">Jon boşiga YaIM</div>
        <div class="v">{gdpPcL ? fmtValue(gdpPc, gdpPcL.value) : '—'}</div>
        {gdpPcL && <small>{gdpPcL.year}-yil {gdpPcRank ? `· ${gdpPcRank.rank}-örin` : ''}</small>}
      </div>
      <div class="fact">
        <div class="k">Inflyatsiya</div>
        <div class="v">{inflL ? fmtValue(infl, inflL.value) : '—'}</div>
        {inflL && <small>{inflL.year}-yil</small>}
      </div>
      <div class="fact">
        <div class="k">Davlat qarzi</div>
        <div class="v">{debtL ? fmtValue(S('davlat-qarzi'), debtL.value) : '—'}</div>
        {debtL && <small>{debtL.year}-yil · YaIMga nisbatan</small>}
      </div>
      <div class="fact">
        <div class="k">Valyuta kursi</div>
        <div class="v">{L('valyuta-kursi') ? fmtNum(L('valyuta-kursi').value, 2) : '—'}</div>
        {L('valyuta-kursi') && <small>milliy valyuta = 1 AQŞ dollariga</small>}
      </div>
    </div>
    <div class="summary">
      <p>
        <b>{country.nameUz}</b> — {country.regionUz.toLowerCase()} mintaqasida joylaşgan
        {country.isAggregate ? 'davlatlar guruhi' : 'davlat'}.
        {popL && popRank && ` Aholi soni — ${fmtValue(popy, popL.value)} (${popL.year}-yil), bu ${popRank.rank}-örin.`}
        {L('zichlik') && ` Aholi ziçligi — km² ga ${fmtNum(L('zichlik').value, 1)} kişi.`}
      </p>
      <p>
        {gdpL && gdpRank &&
          `Nominal YaIM böyiça ${gdpRank.rank}-örinda (${gdpL.year}-yilda ${fmtValue(gdp, gdpL.value)}).`}
        {gdpL && gdpPcL &&
          ` Aholi jon boşiga YaIM — ${fmtValue(gdpPc, gdpPcL.value)} (${gdpPcL.year}-yil).`}
        {lifeL && ` Örtaça umr davomiyligi — ${fmtNum(lifeL.value, 1)} yil (${lifeL.year}-yil).`}
        {hdiL && hdiRank &&
          ` Inson taraqqiyoti indeksi — ${fmtNum(hdiL.value, 3)} ball, ${hdiRank.total} davlat orasida ${hdiRank.rank}-örin (${hdiL.year}-yil).`}
      </p>
    </div>
  </div>

  {charts.length > 0 && (
    <div class="chart-grid">
      {charts.map(({ ind }) => {
        const pts = lastPoints(ind);
        const tips = pts.map((p) => `${p[0]}-yil: ${fmtValue(ind, p[1])}`);
        return (
          <div class="chart-card">
            <h3>{ind.name}</h3>
            <LineChart points={pts} label={ind.name} tips={tips} />
            <div class="src">
              {ind.name}: sönggi {pts.length} yil · manba: {ind.source} · nuqtalar ustiga sichqonçani olib keling
            </div>
          </div>
        );
      })}
    </div>
  )}

  {groups.map((g) => (
    <div class="card">
      <div class="card-title"><span>{g.label}</span></div>
      <table class="data" data-name={`${slug}-${g.key}`}>
        <thead>
          <tr><th>Körsatkiç</th><th class="num">Sana</th><th class="num" data-first="desc">Qiymat</th><th class="num">Örin</th></tr>
        </thead>
        <tbody>
          {g.inds.map((ind) => {
            const l = ind.latest[iso];
            const rk = rankOf(ind, iso);
            return (
              <tr>
                <td>
                  <details class="ind-hist" data-ind={ind.slug} data-link={u(`/korsatkichlar/${ind.slug}`)}>
                    <summary>
                      <span>{ind.name}</span>
                      <a class="row-link" href={u(`/korsatkichlar/${ind.slug}`)} title="Barcha davlatlar körsatkiçi" aria-label="Barcha davlatlar körsatkiçi">↗</a>
                    </summary>
                    <div class="hist-body"></div>
                  </details>
                </td>
                <td class="num" data-v={l ? l.year : ''}>{l ? l.year : '—'}</td>
                <td class="num" data-v={l ? l.value : ''}>{l ? fmtValue(ind, l.value) : '—'}</td>
                <td class="num rank-cell" data-v={rk ? rk.rank : ''}>{rk ? `${rk.rank} / ${rk.total}` : '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  ))}

  <nav style="display:flex; justify-content:space-between; gap:10px; margin:26px 0;">
    {prev ? (
      <a class="btn" style="background:var(--surface-2); color:var(--ink);" href={u(`/davlatlar/${prev.slug}`)}>← {prev.nameUz}</a>
    ) : <span></span>}
    {next && (
      <a class="btn" style="background:var(--surface-2); color:var(--ink);" href={u(`/davlatlar/${next.slug}`)}>{next.nameUz} →</a>
    )}
  </nav>

  <script is:inline type="application/json" id="histData" set:html={histJson} />

  <script>
    /* ============================================================
       Körsatkiç yillar kesimi: davlat sahifasidagi ochiladigan panellar
       ============================================================ */
    (() => {
      'use strict';
      let HIST = null;
      try { HIST = JSON.parse(document.getElementById('histData').textContent); } catch (e) { return; }
      if (!HIST) return;

      /* ---- o'zbekça son formati (server tomonidagi fmtValue bilan bir xil) ---- */
      const fmtNum = (v, dec) => {
        if (v == null || !Number.isFinite(v)) return '—';
        const neg = v < 0;
        const [i, f] = Math.abs(v).toFixed(dec).split('.');
        const g = i.replace(/\B(?=(\d{3})+(?!\d))/g, '\u00A0');
        return (neg ? '−' : '') + g + (f ? ',' + f : '');
      };
      const fmtMoney = (v, dec) => {
        const a = Math.abs(v);
        if (a >= 1e12) return fmtNum(v / 1e12, 2) + '\u00A0trln\u00A0$';
        if (a >= 1e9) return fmtNum(v / 1e9, 1) + '\u00A0mlrd\u00A0$';
        if (a >= 1e6) return fmtNum(v / 1e6, 1) + '\u00A0mln\u00A0$';
        return fmtNum(v, dec ?? 0) + '\u00A0$';
      };
      const fmtVal = (u, d, v) => {
        if (v == null || !Number.isFinite(v)) return '—';
        if (u === 'USD' || u === 'xalqaro dollar') return fmtMoney(v, d);
        if (u === "o'rin") return fmtNum(v, 0) + "-örin";
        if (u && u[0] === '%') return fmtNum(v, d) + '%';
        return fmtNum(v, d);
      };
      const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      /* ---- SVG chizma grafik ---- */
      const fmtTick = (v) => {
        const a = Math.abs(v);
        if (a >= 1e12) return (v / 1e12).toFixed(1).replace('.', ',') + ' trln';
        if (a >= 1e9) return (v / 1e9).toFixed(1).replace('.', ',') + ' mlrd';
        if (a >= 1e6) return (v / 1e6).toFixed(1).replace('.', ',') + ' mln';
        return String(Math.round(v * 100) / 100).replace('.', ',');
      };
      function chartSvg(pts, label, fmt) {
        const W = 640, H = 190, padL = 10, padR = 12, padT = 14, padB = 24;
        const xs = pts.map((p) => p[0]);
        const ys = pts.map((p) => p[1]);
        const xMin = xs[0], xMax = xs[xs.length - 1];
        const yMin = Math.min(...ys), yMax = Math.max(...ys);
        const span = yMax - yMin || 1;
        const px = (x) => padL + ((x - xMin) / (xMax - xMin || 1)) * (W - padL - padR);
        const py = (y) => padT + (H - padT - padB) - ((y - yMin) / span) * (H - padT - padB);
        const path = pts.map((p, i) => (i ? 'L' : 'M') + px(p[0]).toFixed(1) + ',' + py(p[1]).toFixed(1)).join(' ');
        const area = path + ' L' + px(xMax).toFixed(1) + ',' + (H - padB) + ' L' + px(xMin).toFixed(1) + ',' + (H - padB) + ' Z';
        const grids = [0, 0.5, 1].map((t) => yMax - span * t).map((gy) =>
          '<line x1="' + padL + '" x2="' + (W - padR) + '" y1="' + py(gy).toFixed(1) + '" y2="' + py(gy).toFixed(1) + '" stroke="#e6ecf1" stroke-width="1"/>' +
          '<text x="' + (padL + 2) + '" y="' + (py(gy) - 4).toFixed(1) + '" font-size="10.5" fill="#8296a8">' + fmtTick(gy) + '</text>'
        ).join('');
        const xTicks = [...new Set([xMin, Math.round((xMin + xMax) / 2), xMax])];
        const xt = xTicks.map((x) =>
          '<text x="' + px(x).toFixed(1) + '" y="' + (H - 7) + '" font-size="11" fill="#8296a8" text-anchor="' + (x === xMin ? 'start' : x === xMax ? 'end' : 'middle') + '">' + x + '</text>'
        ).join('');
        const dots = pts.map((p) =>
          '<circle class="hit" cx="' + px(p[0]).toFixed(1) + '" cy="' + py(p[1]).toFixed(1) + '" r="9" fill="transparent" tabindex="-1" data-tip="' + p[0] + '-yil: ' + fmt(p[1]) + '"/>' +
          '<circle class="dot" cx="' + px(p[0]).toFixed(1) + '" cy="' + py(p[1]).toFixed(1) + '" r="2.4" fill="#fff" stroke="#134e70" stroke-width="1.5"/>'
        ).join('');
        return '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="' + esc(label) + '">' +
          grids +
          '<path d="' + area + '" fill="#134e70" opacity="0.09"/>' +
          '<path d="' + path + '" fill="none" stroke="#134e70" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>' +
          dots + xt + '</svg>';
      }

      /* ---- panelni to'ldirish ---- */
      function renderHist(det) {
        const body = det.querySelector('.hist-body');
        const info = HIST[det.dataset.ind];
        if (!info || !info.s || !info.s.length) {
          body.innerHTML = '<div class="hist-empty">Bu davlat üçün bu körsatkiç bo\'yicha yillik ma\'lumotlar mövcut değil.</div>';
          return;
        }
        const pts = info.s;

        const vals = pts.map((p) => p[1]).filter((v) => Number.isFinite(v));
        const min = vals.length ? Math.min(...vals) : null;
        const max = vals.length ? Math.max(...vals) : null;
        const avg = vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : null;

        let stats = '<div class="hist-stats">' +
          '<span>Yillar: <b>' + pts[0][0] + '–' + pts[pts.length - 1][0] + '</b></span>' +
          '<span>Ballari: <b>' + pts.length + '</b></span>';
        if (min != null) {
          stats += '<span>Eng past: <b>' + fmtVal(info.u, info.d, min) + '</b> (' + pts.find((p) => p[1] === min)[0] + ')</span>';
          stats += '<span>Eng yuqori: <b>' + fmtVal(info.u, info.d, max) + '</b> (' + pts.find((p) => p[1] === max)[0] + ')</span>';
        }
        if (avg != null) stats += '<span>Örtacha: <b>' + fmtVal(info.u, info.d, avg) + '</b></span>';
        stats += '</div>';

        const rows = [];
        for (let i = pts.length - 1; i >= 0; i--) {
          const y = pts[i][0];
          const v = pts[i][1];
          let delta = '';
          if (i > 0) {
            const prev = pts[i - 1][1];
            if (Number.isFinite(prev) && prev !== 0) {
              const pct = ((v - prev) / Math.abs(prev)) * 100;
              if (Number.isFinite(pct)) {
                const cls = pct > 0 ? 'pos' : 'neg';
                delta = '<span class="' + cls + '">' + (pct > 0 ? '+' : '−') + fmtNum(Math.abs(pct), 1) + '%</span>';
              }
            }
          }
          rows.push(
            '<tr><td class="num" data-v="' + y + '">' + y + '</td>' +
            '<td class="num" data-v="' + v + '">' + fmtVal(info.u, info.d, v) + '</td>' +
            '<td class="num">' + delta + '</td></tr>'
          );
        }

        const tbl = '<table class="data compact" data-name="' + det.dataset.ind + '-yıllar">' +
          '<thead><tr><th class="num">Yil</th><th class="num">' + esc(info.n) + '</th><th class="num">Ötgan yilga özgariş</th></tr></thead>' +
          '<tbody>' + rows.join('') + '</tbody></table>';

        body.innerHTML =
          chartSvg(pts, info.n, (v) => fmtVal(info.u, info.d, v)) +
          stats +
          tbl +
          '<div class="hist-more">Manba: ' + esc(info.src) + ' · <a href="' + det.dataset.link + '">Barcha davlatlar üçün bu körsatkiç →</a></div>';

        document.dispatchEvent(new Event('tables:render'));
      }

      document.addEventListener('toggle', (e) => {
        const det = e.target;
        if (det && det.tagName === 'DETAILS' && det.classList.contains('ind-hist') && det.open && !det.dataset.init) {
          det.dataset.init = '1';
          renderHist(det);
        }
      }, true);
    })();
  </script>
</Base>
