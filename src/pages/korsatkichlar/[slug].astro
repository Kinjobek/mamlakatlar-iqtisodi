---
import Base from '../../layouts/Base.astro';
import Flag from '../../components/Flag.astro';
import { u } from '../../lib/u.mjs';
import { registry, fmtValue } from '../../lib/data.mjs';

export function getStaticPaths() {
  const R = registry();
  return R.indicators.map((i) => ({ params: { slug: i.slug } }));
}

const slug = Astro.params.slug;
const R = registry();
const ind = R.bySlug.get(slug);
if (!ind) throw new Error(`Ko'rsatkich topilmadi: ${slug}`);

const catLabel = R.catalog.categories[ind.cat];

const rows = [];
for (const c of R.countries) {
  const l = ind.latest[c.iso3];
  const rk = ind.rank.get(c.iso3);
  rows.push({ c, l, rk });
}
const ranked = rows.filter((r) => r.l && !r.c.isAggregate).sort((a, b) => a.rk - b.rk);
const aggs = rows.filter((r) => r.c.isAggregate && r.l);

const uzb = R.byIso.get('UZB');
const uzbRow = ranked.find((r) => r.c.iso3 === 'UZB');

const years = Object.values(ind.latest).map((l) => l.year);
const maxYear = Math.max(...years);
const minYear = Math.min(...years);
const coverCount = ranked.length;

const title = `${ind.name} — barcha davlatlar | Mamlakatlar iqtisodi`;
---

<Base title={title} description={`${ind.name}: ${coverCount} davlat uchun so'nggi qiymatlar va reyting (${minYear}–${maxYear}). ${ind.desc}`}>
  <div class="crumbs">
    <a href={u('/')}>Bosh sahifa</a> ›
    <a href={u('/korsatkichlar')}>Ko'rsatkichlar</a> ›
    <a href={u('/korsatkichlar')} style="pointer-events:none;">{catLabel}</a> ›
    {ind.name}
  </div>

  <div class="page-head">
    <h1>{ind.name}</h1>
    <p class="lead">
      Birlik: <b>{ind.unit}</b> · Manba: <b>{ind.source}</b> · Qamrov:
      <b> {coverCount} davlat</b> · So'nggi ma'lumot: <b>{maxYear}-yil</b>
      {ind.lowerBetter ? ' · reytingda past qiymat = yaxshiroq' : ''}
    </p>
  </div>

  <div class="card">
    <div class="card-title"><span>Ko'rsatkich haqida</span></div>
    <div class="summary">
      <p>{ind.desc}</p>
      <p style="color:var(--muted); font-size:14px;">
        Inglizcha nomi: {ind.rawName} ({ind.code}) — {ind.source} ma'lumotlar bazasi.
      </p>
    </div>
  </div>

  {uzbRow && (
    <div class="stat-strip">
      <div class="stat">
        <div class="k">O'zbekiston qiymati</div>
        <div class="v">{fmtValue(ind, uzbRow.l.value)}</div>
        <div class="s">{uzbRow.l.year}-yil</div>
      </div>
      <div class="stat">
        <div class="k">O'zbekiston o'rni</div>
        <div class="v">{uzbRow.rk}-o'rin</div>
        <div class="s">{coverCount} davlat orasida</div>
      </div>
      <div class="stat">
        <div class="k">Eng yuqori</div>
        <div class="v">{fmtValue(ind, ranked[0].l.value)}</div>
        <div class="s">{ranked[0].c.nameUz} ({ranked[0].l.year})</div>
      </div>
      <div class="stat">
        <div class="k">Eng past</div>
        <div class="v">{fmtValue(ind, ranked[ranked.length - 1].l.value)}</div>
        <div class="s">{ranked[ranked.length - 1].c.nameUz} ({ranked[ranked.length - 1].l.year})</div>
      </div>
    </div>
  )}

  <input
    class="filter-input"
    id="indSearch"
    type="search"
    placeholder="Davlatnomi bo'yicha filtrlash..."
    aria-label="Davlat qidirish"
  />

  <div class="card">
    <table class="data" id="indTable">
      <thead>
        <tr>
          <th>O'rin</th>
          <th>Davlat</th>
          <th class="num">Sana</th>
          <th class="num">{ind.name}</th>
        </tr>
      </thead>
      <tbody>
        {ranked.map((r) => (
          <tr class={r.c.iso3 === 'UZB' ? 'hl' : ''} data-name={r.c.nameUz}>
            <td class="rank-cell">{r.rk}</td>
            <td>
              <a class="name-cell" href={u(`/davlatlar/${r.c.slug}`)}>
                <Flag iso2={r.c.iso2} iso3={r.c.iso3} />
                <span>{r.c.nameUz}</span>
              </a>
            </td>
            <td class="num">{r.l.year}</td>
            <td class="num">{fmtValue(ind, r.l.value)}</td>
          </tr>
        ))}
        {aggs.map((r) => (
          <tr class="aggregate-row" data-name={r.c.nameUz}>
            <td class="rank-cell">—</td>
            <td>
              <a class="name-cell" href={u(`/davlatlar/${r.c.slug}`)}>
                <Flag iso2={r.c.iso2} iso3={r.c.iso3} />
                <span>{r.c.nameUz}</span>
              </a>
            </td>
            <td class="num">{r.l.year}</td>
            <td class="num">{fmtValue(ind, r.l.value)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="card-note">
      {ind.lowerBetter
        ? "Reyting o'sish tartibida: past qiymat kuchli o'rin hisoblanadi."
        : 'Reyting kamayish tartibida.'}{' '}
      Qiymatlar har bir davlat uchun ko'rsatkichning so'nggi mavjud yiliga tegishli.
    </div>
  </div>

  <script>
    const input = document.getElementById('indSearch');
    const tbody = document.querySelector('#indTable tbody');
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      for (const tr of tbody.querySelectorAll('tr')) {
        tr.style.display = !q || tr.dataset.name.toLowerCase().includes(q) ? '' : 'none';
      }
    });
  </script>
</Base>
