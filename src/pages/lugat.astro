---
import Base from '../layouts/Base.astro';
import { u } from '../lib/u.mjs';
import { registry } from '../lib/data.mjs';

const R = registry();

const uiTerms = [
  ['Boş sahifa', 'Saytning asosiy sahifasi'],
  ['Davlatlar', 'Barça davlatlar katalogi'],
  ['Körsatkiçlar', 'Iqtisodiy va demografik ölçovlar katalogi'],
  ['Taqqoslaş', 'Ikki yoki undan ortiq davlat körsatkiçlarini yonma-yon soliştiriş'],
  ['Luğat', 'Atamalar ma\'lumotnomasi'],
  ['Manbalar', 'Ma\'lumot manbalari röyxati'],
  ['Poytaxt', 'Davlatning ma\'muriy markazi'],
  ['Mintaqa', 'BMT tasnifidagi geografik-iqtisodiy mintaqa'],
  ['Daromad darajasi', 'World Bank tasnifi: yuqori, yuqori-örta, quyi-örta, quyi daromadli'],
  ['Agregat', 'Bir neça davlatni birlaştirgan hisob (masalan, Jahon, Yevropa Ittifoqi)'],
  ['Yillar kesimi', 'Körsatkiçning yillar böyiça qatori'],
  ['Sönggi qiymat', 'Davlat uçun körsatkiçning oxirgi mavjud rasmiy qiymati'],
  ['Örin (reyting)', 'Boşqa davlatlar orasidagi pozitsiya']
];
---

<Base title="Luğat | Mamlakatlar iqtisodi" description="Saytda işlatiladigan iqtisodiy va demografik atamalarning özbekça izohli luğati: YaIM, INI, Gini indeksi, ITT va boşqalar.">
  <div class="page-head">
    <h1>Luğat</h1>
    <p class="lead">
      Saytda işlatiladigan atamalarning qisqaça özbekça izohi. Körsatkiçlarning
      batafsil ta'rifi har bir körsatkiç sahifasida beriladi.
    </p>
  </div>

  <div class="card">
    <div class="card-title"><span>Interfeys atamalari</span></div>
    <div class="summary">
      <dl class="dict">
        {uiTerms.map(([t, d]) => (
          <dt>{t}</dt><dd>{d}</dd>
        ))}
      </dl>
    </div>
  </div>

  {Object.entries(R.catalog.categories).map(([key, label]) => {
    const inds = R.indicators.filter((i) => i.cat === key);
    if (!inds.length) return null;
    return (
      <div class="card">
        <div class="card-title"><span>{label}</span></div>
        <div class="summary">
          <dl class="dict">
            {inds.map((ind) => (
              <dt>{ind.name}</dt>
              <dd>
                {ind.desc}
                <div style="color:var(--muted); font-size:13px;">
                  Birlik: {ind.unit} · <a href={u(`/korsatkichlar/${ind.slug}`)}>Barça davlatlar →</a>
                </div>
              </dd>
            ))}
          </dl>
        </div>
      </div>
    );
  })}
</Base>
