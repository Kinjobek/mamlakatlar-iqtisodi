---
import Base from '../layouts/Base.astro';

const sources = [
  {
    name: 'World Bank Open Data',
    url: 'https://data.worldbank.org',
    role: "Saytdagi köp körsatkiçlarning asosiy manbasi: YaIM, aholi, işsizlik, taşqi savdo, energetika, demografiya va boşqalar.",
    license: 'Oçiq ma\'lumotlar litsenziyasi — manba körsatilgan holda erkin işlatiş mumkin.'
  },
  {
    name: 'IMF DataMapper (World Economic Outlook)',
    url: 'https://www.imf.org/external/datamapper',
    role: "Davlat qarzi (% YaIM) va byudjet taqçilligi/profitsiti ma'lumotlari.",
    license: 'IMF oçiq ma\'lumotlar siyosati.'
  },
  {
    name: 'UNDP — Inson taraqqiyoti indeksi (HDI)',
    url: 'https://hdr.undp.org',
    role: "Inson taraqqiyoti indeksi (ITT) böyiça yillik ma'lumotlar (OWID orqali olingan).",
    license: 'CC BY 4.0'
  },
  {
    name: 'UN Comtrade Plus (BMT Statistika bölimi)',
    url: 'https://comtradeplus.un.org',
    role: "Taşqi savdo tahlili bölimi: hamkorlar kesimi va AG6 (6 xonali HS) mahsulotlar kesimi.",
    license: "BMT oçiq ma'lumotlar siyosati."
  },
  {
    name: 'flagcdn.com',
    url: 'https://flagcdn.com',
    role: "Davlat bayroqlari tasvirlari.",
    license: "Bepul CDN xizmati."
  }
];
---

<Base title="Manbalar | Mamlakatlar iqtisodi" description="Sayt ma'lumotlarining manbalari: World Bank, IMF, UNDP. Har bir manbaning litsenziyasi va qamrovi.">
  <div class="page-head">
    <h1>Ma'lumot manbalari</h1>
    <p class="lead">
      Saytdagi barça raqamlar xalqaro taşkilotlarning oçiq ma'lumot bazalaridan olingan.
      Ular milliy statistika idoralarining rasmiy hisobotlariga asoslanadi, biroq ta'rif,
      qamrov va hisoblaş usullari tufayli milliy manbalardan farq qilişi mumkin.
    </p>
  </div>

  <div class="card">
    <table class="data">
      <thead>
        <tr><th>Manba</th><th>Qamrov</th><th>Litsenziya</th></tr>
      </thead>
      <tbody>
        {sources.map((s) => (
          <tr>
            <td><a href={s.url} rel="noopener" target="_blank" style="font-weight:700;">{s.name}</a></td>
            <td>{s.role}</td>
            <td style="color:var(--muted);">{s.license}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="card-note">
      Muayyan körsatkiç qaysi manbadan olingani har bir körsatkiç sahifasida körsatiladi.
    </div>
  </div>

  <div class="card">
    <div class="card-title"><span>Muhim eslatmalar</span></div>
    <div class="summary">
      <p>
        1. Qiymatlar har bir davlat uçun körsatkiçning <b>sönggi mavjud yiliga</b> tegişli —
        turli davlatlar uçun bu yil har xil bölişi mumkin (masalan, ayrim rivojlanayotgan
        davlatlarda ma'lumotlar keçikib e'lon qilinadi).
      </p>
      <p>
        2. Agregatlar (Jahon, Yevropa Ittifoqi, yevro zonasi) alohida ajratib körsatiladi va
        reytinglarda qatnaşmaydi.
      </p>
      <p>
        3. Manba taşkilotlar eski ma'lumotlarni tuzatib qayta e'lon qilişi mumkin — ma'lumotlar
        yangilanganda qiymatlar özgaradi.
      </p>
    </div>
  </div>
</Base>
